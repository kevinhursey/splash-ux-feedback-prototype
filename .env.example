# Local: copy to .env.local (never commit real keys).
# Vercel: add the same VITE_* names under Project → Settings → Environment Variables
# for Preview AND Production, then trigger a new deployment. Vite inlines VITE_* at
# build time, so missing vars on Vercel = empty client and failed submissions.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_APP_ENV=test
